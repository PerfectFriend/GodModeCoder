# ACE-Step Environment Configuration (ROCm 7.2 Windows)
# Copy this file to .env in ace-step/extracted/ and modify as needed

# ==================== Model Settings ====================
# DiT model path
ACESTEP_CONFIG_PATH=acestep-v15-turbo

# LM model path (used when LLM is enabled)
# Available: acestep-5Hz-lm-0.6B, acestep-5Hz-lm-1.7B, acestep-5Hz-lm-4B
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-1.7B

# Device selection: auto, cuda, cpu, xpu
ACESTEP_DEVICE=auto

# LM backend: vllm (faster) or pt (PyTorch native)
# Windows ROCm: pt only (vllm requires Linux)
ACESTEP_LM_BACKEND=pt

# LLM initialization: auto (enabled if VRAM > 6GB), true, false
# auto = enabled if VRAM > 6GB
ACESTEP_INIT_LLM=auto

# ==================== ROCm Settings ====================
# RDNA3 gfx1102 override (RX 7600/780M = 11.0.2, RX 7800 XT = 11.0.1, RX 7900 = 11.0.0)
HSA_OVERRIDE_GFX_VERSION=11.0.2

# Disable torch.compile Triton backend (not available on ROCm Windows)
TORCH_COMPILE_BACKEND=eager

# MIOpen: use fast heuristic kernel selection instead of exhaustive benchmarking
# Without this, first-run VAE decode hangs for minutes on each conv layer
MIOPEN_FIND_MODE=FAST

# HuggingFace tokenizer parallelism
TOKENIZERS_PARALLELISM=false

# ==================== API Server Settings ====================
# Default values (used if not set in .env file)
# You can override these by uncommenting and modifying the lines below
# or by creating a .env file (recommended to survive updates)

# Server host (127.0.0.1 for local, 0.0.0.0 for network)
# SERVER_NAME=127.0.0.1

# Server port
# PORT=8001

# API key for authentication (optional)
# ACESTEP_API_KEY=sk-your-api-key

# Download source: auto, huggingface, modelscope
# DOWNLOAD_SOURCE=auto

# Git update check (true/false)
# CHECK_UPDATE=true

# Model configuration
# CONFIG_PATH=--config_path acestep-v15-turbo
# LM_MODEL_PATH=--lm_model_path acestep-5Hz-lm-1.7B

# ==================== Debug Overrides ====================
# Set to simulate different GPU VRAM for testing tier configurations
# MAX_CUDA_VRAM=8
# MAX_MPS_VRAM=16