# ACE-Step ROCm 7.2 Environment Configuration
# Copy to .env in ace-step/extracted/ directory

# ==================== Model Settings ====================
ACESTEP_CONFIG_PATH=acestep-v15-turbo
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-1.7B
ACESTEP_LM_BACKEND=pt              # vllm NOT available on ROCm Windows
ACESTEP_INIT_LLM=true
ACESTEP_DOWNLOAD_SOURCE=auto

# ==================== ROCm Specifics ====================
# Radeon 780M = gfx1102 (RDNA3)
HSA_OVERRIDE_GFX_VERSION=11.0.1
MIOPEN_FIND_MODE=FAST
TORCH_COMPILE_BACKEND=eager
TOKENIZERS_PARALLELISM=false
PYTORCH_HIP_ALLOC_CONF=garbage_collection_threshold:0.6,max_split_size_mb:128

# ==================== API Server (optional) ====================
# ACESTEP_API_KEY=your-secret-key
# PORT=8001
# SERVER_NAME=0.0.0.0

# ==================== Gradio UI (optional) ====================
# PORT=7860
# SERVER_NAME=127.0.0.1
# LANGUAGE=en
# ACESTEP_BATCH_SIZE=4