# SuperGuard standalone config - place NEXT TO panic_mode_yellow.py as sguard.env
# Own alarm bot token (from @BotFather) - NOT the Hermes gateway token!
# Reason: the Hermes Telegram gateway long-polls its own token; a second poller
# on the same token gets 409 Conflict and silently loses all button callbacks.
# A separate bot = no competition, buttons always work. Chat_id stays the same
# (it is per-USER, not per-bot - alarm photos land in the same chat).
SG_TELEGRAM_BOT_TOKEN=
SG_CHAT_ID=143293811
# Bot username - poll loop matches commands with AND without @username suffix
SG_BOT_USERNAME=superguard_alarm_bot
SG_PLUG_IP=192.168.137.109
SG_PLUG_ID=
SG_PLUG_KEY=
SG_CAM_URL=https://atcs.banjarkota.go.id:5443/LiveApp/streams/Ptzparungsari.m3u8
SG_UPDATE_EVERY=2.0
SG_DETECT_EVERY=1.5
SG_YELLOW_MIN_FRACTION=0.15
SG_MIN_CONF=0.35
SG_MIN_YELLOW_VEHICLES=1
SG_REQUIRE_FRAMES=2
SG_AUTO_RESOLVE_FRAMES=5
